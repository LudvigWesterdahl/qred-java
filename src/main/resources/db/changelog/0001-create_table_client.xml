<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
                   logicalFilePath="0001-create_table_client.xml">

    <changeSet id="0001-create_table_client" author="ludvig">
        <createTable tableName="client">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="client_number" type="VARCHAR(64)">
                <constraints nullable="false" />
            </column>
        </createTable>

        <addUniqueConstraint tableName="client" constraintName="uq_client_client_number" columnNames="client_number" />
    </changeSet>

</databaseChangeLog>

<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
                   logicalFilePath="0003-create_table_payment.xml">

    <changeSet id="0003-create_table_payment" author="ludvig">
        <createTable tableName="payment">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true" />
            </column>
            <column name="payment_date" type="DATE">
                <constraints nullable="false" />
            </column>
            <column name="amount" type="DECIMAL(15, 2)">
                <constraints nullable="false" />
            </column>
            <column name="type" type="VARCHAR(16)">
                <constraints nullable="false" />
            </column>
            <column name="contract_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createIndex tableName="payment" indexName="idx_payment_contract">
            <column name="contract_id" />
        </createIndex>

        <addForeignKeyConstraint baseTableName="payment"
                                 baseColumnNames="contract_id"
                                 constraintName="fk_payment_contract"
                                 referencedTableName="contract"
                                 referencedColumnNames="id"
                                 onDelete="RESTRICT"
                                 onUpdate="RESTRICT" />
    </changeSet>

</databaseChangeLog>
